<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <AssemblyName>WallJoinerSuper</AssemblyName>
    <RootNamespace>ProWallTools</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>Wall Joiner Super</AssemblyTitle>
    <Product>Wall Joiner Super</Product>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0</FileVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- AutoCAD APIs references via NuGet package (runtime exclusion is mandatory) -->
    <PackageReference Include="AutoCAD.NET" Version="23.1.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference local AdWindows.dll from AutoCAD 2021 installation for Ribbon API -->
    <Reference Include="AdWindows">
      <HintPath>C:\Program Files\Autodesk\AutoCAD 2021\AdWindows.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Ảnh nhúng vào Assembly dưới dạng WPF Resource (Pack URI: pack://application:,,,/WallJoinerSuper;component/Resources/xxx.png) -->
    <Resource Include="Resources\IconRibbon_Settings_32px.png" />
    <Resource Include="Resources\IconRibbon_Wall-Joiner_32px.png" />
    <Resource Include="Resources\IconRibbon_Wall-Finisher_32px.png" />
    <Resource Include="Resources\IconRibbon_Beautify_32px.png" />
  </ItemGroup>

  <!-- Automation Build Target to copy build bundle to Autodesk Plugins folder -->
  <Target Name="CopyToPlugins" AfterTargets="Build">
    <PropertyGroup>
      <PluginDir>$(APPDATA)\Autodesk\ApplicationPlugins\WallJoinerSuper.bundle</PluginDir>
      <ContentsDir>$(PluginDir)\Contents</ContentsDir>
    </PropertyGroup>
    
    <Message Text="[AutoBuild] Deploying plugin to: $(PluginDir)" Importance="high" />
    <MakeDir Directories="$(ContentsDir)" />
    
    <!-- Copy PackageContents.xml from project root to bundle folder -->
    <Copy SourceFiles="$(ProjectDir)PackageContents.xml" DestinationFolder="$(PluginDir)" SkipUnchangedFiles="true" />
    
    <!-- Copy compiled binaries to Contents folder -->
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(ContentsDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb" DestinationFolder="$(ContentsDir)" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    
    <!-- Copy ribbon icons (.ico) to Resource folder inside bundle -->
    <ItemGroup>
      <IconFiles Include="$(ProjectDir)Resources\*.ico" />
    </ItemGroup>
    <Copy SourceFiles="@(IconFiles)" DestinationFolder="$(ContentsDir)\Resource" SkipUnchangedFiles="true" />
  </Target>
</Project>