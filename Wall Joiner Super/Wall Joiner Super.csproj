<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <AssemblyName>WallJoinerSuper</AssemblyName>
    <RootNamespace>ProWallTools</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>Wall Joiner Super</AssemblyTitle>
    <Product>Wall Joiner Super</Product>
    <Version>1.1.0</Version>
    <FileVersion>1.1.0</FileVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <LangVersion>7.3</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DeployPlugin Condition="'$(DeployPlugin)'==''">false</DeployPlugin>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- AutoCAD APIs references via NuGet package (runtime exclusion is mandatory) -->
    <PackageReference Include="AutoCAD.NET" Version="23.1.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wall Joiner Geometry\Wall Joiner Geometry.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ảnh nhúng vào Assembly dưới dạng WPF Resource (Pack URI: pack://application:,,,/WallJoinerSuper;component/Resources/xxx.png) -->
    <Resource Include="Resources\IconRibbon_Settings_32px.png" />
    <Resource Include="Resources\IconRibbon_Wall-Joiner_32px.png" />
    <Resource Include="Resources\IconRibbon_Wall-Finisher_32px.png" />
    <Resource Include="Resources\IconRibbon_Beautify_32px.png" />
  </ItemGroup>

  <Target Name="PackagePlugin" AfterTargets="Build">
    <PropertyGroup>
      <BundleDir>$(TargetDir)WallJoinerSuper.bundle</BundleDir>
      <ContentsDir>$(BundleDir)\Contents</ContentsDir>
    </PropertyGroup>

    <Message Text="[Package] Creating plugin bundle: $(BundleDir)" Importance="high" />
    <RemoveDir Directories="$(BundleDir)" Condition="Exists('$(BundleDir)')" />
    <MakeDir Directories="$(ContentsDir)" />
    <MakeDir Directories="$(ContentsDir)\Resource" />
    <Copy SourceFiles="$(ProjectDir)PackageContents.xml" DestinationFolder="$(BundleDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(ContentsDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb" DestinationFolder="$(ContentsDir)" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />

    <ItemGroup>
      <PluginDependency Include="$(TargetDir)WallJoiner.Geometry.dll" Condition="Exists('$(TargetDir)WallJoiner.Geometry.dll')" />
      <PluginDependency Include="$(TargetDir)FSharp.Core.dll" Condition="Exists('$(TargetDir)FSharp.Core.dll')" />
      <IconFiles Include="$(ProjectDir)Resources\*.ico" />
    </ItemGroup>
    <Error Condition="!Exists('$(TargetDir)WallJoiner.Geometry.dll')" Text="WallJoiner.Geometry.dll was not produced; the F# geometry project must build successfully." />
    <Error Condition="!Exists('$(TargetDir)FSharp.Core.dll')" Text="FSharp.Core.dll was not copied to the plugin output; AutoCAD requires it at runtime." />
    <Copy SourceFiles="@(PluginDependency)" DestinationFolder="$(ContentsDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(IconFiles)" DestinationFolder="$(ContentsDir)\Resource" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="DeployPluginBundle" AfterTargets="PackagePlugin" Condition="'$(DeployPlugin)'=='true'">
    <PropertyGroup>
      <PluginDir>$(APPDATA)\Autodesk\ApplicationPlugins\WallJoinerSuper.bundle</PluginDir>
    </PropertyGroup>
    <ItemGroup>
      <BundleFiles Include="$(BundleDir)\**\*" />
    </ItemGroup>
    <Error Condition="'$(APPDATA)'==''" Text="APPDATA is required to deploy WallJoinerSuper.bundle safely." />
    <Message Text="[Deploy] Copying plugin to: $(PluginDir)" Importance="high" />
    <RemoveDir Directories="$(PluginDir)" Condition="Exists('$(PluginDir)')" />
    <MakeDir Directories="$(PluginDir)" />
    <Copy
      SourceFiles="@(BundleFiles)"
      DestinationFiles="@(BundleFiles->'$(PluginDir)\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
